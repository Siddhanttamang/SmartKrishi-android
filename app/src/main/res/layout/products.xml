<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F9F9F9"
    android:padding="12dp">

    <!-- Search and Sell Button Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="12dp">

        <!-- Modern Search View -->
        <SearchView
            android:id="@+id/productSearch"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:queryHint="Search..."
            android:layout_marginEnd="8dp"
            android:iconifiedByDefault="false"
            app:iconifiedByDefault="false"
            android:background="@drawable/searchview_background" />

        <!-- Sell Vegetable Button -->
        <Button
            android:id="@+id/btnSell"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="Sell Vegetable"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:paddingHorizontal="16dp"
            android:background="@drawable/button_rounded_green" />
    </LinearLayout>

    <!-- Product List -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/productsRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:scrollbars="vertical" />
    <TextView
        android:id="@+id/productLoginRequired"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Login to view and sell vegetables"
        android:textColor="@android:color/holo_red_dark"
        android:gravity="center"
        android:visibility="gone"
        android:padding="16dp"/>


    <!-- Lottie Loading Animation -->
    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/productsLoading"
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:layout_gravity="center"
        app:lottie_rawRes="@raw/loading"
        app:lottie_autoPlay="true"
        app:lottie_loop="true"
        android:visibility="gone" />
</LinearLayout>
