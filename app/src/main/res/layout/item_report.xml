<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="10dp"
    android:layout_marginHorizontal="8dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Top Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#DDDDDD" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="12dp"
            android:background="#D8F3DC">

            <!-- Report Image -->
            <ImageView
                android:id="@+id/reportImage"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:scaleType="centerCrop"
                android:contentDescription="Image showing detected pest or disease"
                android:src="@drawable/ic_launcher_background" />

            <!-- Text Content -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="12dp"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/cropName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Crop Name"
                    android:textStyle="bold"
                    android:textSize="15sp"
                    android:textColor="#212121"
                    android:maxLines="2"
                    android:ellipsize="end"
                    android:contentDescription="Crop name: Crop Name" />

                <TextView
                    android:id="@+id/disease"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Disease"
                    android:textStyle="bold"
                    android:textSize="15sp"
                    android:textColor="#212121"
                    android:maxLines="2"
                    android:ellipsize="end"
                    android:contentDescription="Detected disease: Disease" />

                <TextView
                    android:id="@+id/recommendation"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Recommendation"
                    android:textStyle="italic"
                    android:textSize="15sp"
                    android:textColor="#212121"
                    android:maxLines="2"
                    android:ellipsize="end"
                    android:contentDescription="Recommendation: Recommendation" />

                <TextView
                    android:id="@+id/createdAt"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Created at"
                    android:textSize="12sp"
                    android:textColor="@color/black"
                    android:layout_marginTop="8dp"
                    android:contentDescription="Report created at: Created at" />

            </LinearLayout>
        </LinearLayout>

        <!-- Bottom Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#DDDDDD" />

    </LinearLayout>
</androidx.cardview.widget.CardView>
